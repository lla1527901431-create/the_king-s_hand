# ============================================================================
# The King's Hand —— 环境变量示例
# ============================================================================
# 用法：复制成 .env，然后填入真实值。
#     cp .env.example .env
#
# ⚠️ .env 不要提交到 git（.gitignore 里已经排除）
#
# ⚠️ 这里**没有** DEEPSEEK_API_KEY / SMTP_* ：用户自己的密钥由用户在页面上
#    填写，加密后存进 Supabase 的 user_secrets 表。服务端不再持有任何
#    第三方密钥，避免"任何人注册后都能白嫖服务器额度"。
# ============================================================================

# ---- DeepSeek（模型与地址是服务端配置；key 由用户自己填）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MEMORY_MODEL=deepseek-v4-flash

# ---- Supabase（必填）----
# 在 Supabase 控制台 → Project Settings → API 里找
SUPABASE_URL=https://你的项目ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_你的key

# ---- 用户密钥加密主密钥（必填）----
# 生成：python tools/gen_master_key.py
# ⚠️ 必须离线备份。丢失后已保存的所有用户密钥都无法解密。
# ⚠️ 部署时**必须与本地保持一致**，换了它用户就得重填 Key。
SECRET_MASTER_KEY=

# ---- 运行模式 ----
# 本地调试 true（开启热重载）；公网部署 false
DEBUG=false

# 会话 cookie 是否带 Secure 标记
#   本地 http 调试：false（设成 true 浏览器会拒绝保存 cookie，登不进去）
#   公网 HTTPS：**必须 true**（否则会话凭证可能通过明文 HTTP 泄露）
COOKIE_SECURE=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 监听地址（部署到容器/服务器时通常由 docker-compose 覆盖）----
# 本地：127.0.0.1（只允许本机）
# 容器/服务器：0.0.0.0
HOST=127.0.0.1
PORT=8000

# 工作进程数
# ⚠️ 目前对话历史存在进程内存里，workers > 1 会导致"同一个人刷到不同进程时
#    上下文丢失"。要调大请先看 DEPLOY.md 的说明。
WORKERS=1
